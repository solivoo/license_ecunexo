# =============================================================================
# license_ecunexo — variables Portainer / Docker Compose
# Copiar a .env junto a docker-compose.yml (o pegar en Portainer → Stack → Env)
# NUNCA subir .env al git.
# =============================================================================

# --- Imágenes / versión ---
LICENSE_API_IMAGE=ecunexo-license-api:1.7.0
LICENSE_SPA_IMAGE=ecunexo-license-spa:1.7.0

# --- Puertos publicados en el host (Oracle / Portainer) ---
LICENSE_API_HOST_PORT=5090
LICENSE_SPA_HOST_PORT=5174

# --- Postgres (solo Platform; BD distinta del cliente) ---
POSTGRES_DB=licensing_ecunexo
POSTGRES_USER=licensing
POSTGRES_PASSWORD=CAMBIA_PASSWORD_FUERTE_AQUI

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
DATABASE_MIGRATE_ON_STARTUP=true

# JWT operadores Platform (mín. 32 caracteres)
JWT_ISSUER=EcuNexo
JWT_AUDIENCE=EcuNexo.Platform.Api
JWT_SIGNING_KEY=CAMBIA_ESTO_MINIMO_32_CARACTERES_ALEATORIOS!!

# Peppers (doble hash ADR-008). IssuePepper NUNCA va al cliente.
# ValidationPepper SÍ se entrega al producto Cliente (mismo valor).
ISSUE_PEPPER=CAMBIA_PEPPER_EMISION_SOLO_CEO_MIN_16
VALIDATION_PEPPER=CAMBIA_PEPPER_VALIDACION_COMPARTIR_CON_CLIENTE_16

# Cifrado payload de provisioning (mín. ~32 chars)
PROVISIONING_ENCRYPTION_KEY=CAMBIA_CIFRADO_PROVISIONING_32_CHARS_MIN!!

# ---------------------------------------------------------------------------
# Llave RSA de firma de licencias (artefacto)
# Generar en tu PC:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out license-private.pem
#   openssl rsa -in license-private.pem -pubout -out license-public.pem
# license-private.pem → solo Platform (volumen abajo)
# license-public.pem  → producto Cliente (LicenseValidation:SigningPublicKeyPem)
# ---------------------------------------------------------------------------
LICENSE_PRIVATE_KEY_PATH=/keys/license-private.pem
# Ruta ABSOLUTA en el host donde Portainer/Docker monta la carpeta de llaves.
# Ejemplo Oracle VM: /opt/ecunexo/licencias/keys
# Dentro debe existir: license-private.pem (chmod 600)
LICENSE_KEYS_HOST_PATH=/opt/ecunexo/licencias/keys

# Orígenes SPA permitidos (CORS), separados por coma. Ejemplos:
#   https://licencias.tudominio.com,https://licencias.tudominio.com:443
#   http://TU_IP_ORACLE:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174

# ---------------------------------------------------------------------------
# SPA: detrás de Cloudflare HTTPS deja VITE_API_BASE_URL vacío.
# Nginx proxy /api → contenedor api (mismo origen, sin mixed content).
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_LICENSE_SYNCFUSION=
VITE_LOGNERD_ENABLE_CONSOLE=false
VITE_LOGNERD_LEVEL=WARN

# Primer operador (solo si la BD está vacía)
BOOTSTRAP_OPERATOR_ENABLED=true
BOOTSTRAP_OPERATOR_EMAIL=admin@ecunexo.local
BOOTSTRAP_OPERATOR_PASSWORD=CambiaEstoYa123!
BOOTSTRAP_OPERATOR_NAME=Administrador

# CORS: con proxy mismo origen no hace falta; si expones :5090 directo, pon el origen HTTPS de la SPA
CORS_ALLOWED_ORIGINS=
